# Deny by PATTERN, not by name. Every file this project produces about a real
# photo library is personal -- paths, GPS, people tags, captions, OAuth tokens --
# and a name-based list only blocks the files that existed when it was written.
# Anything new must be denied by default.

# Data: every manifest, ledger, plan and cache this tool writes.
*.tsv
*.tsv.gz
all_dates.txt
*_done.txt
*_report.txt
*.log

# Credentials. Never, under any name.
*token*.json
*client_secret*.json
*credentials*.json
.upload_test_passed

# Private notes. These stay in ~/.local/share/gphotos/notes/, never in git.
STATE.md
GOAL.md
PROCEDURE.md

# Working trees a run creates in the repo directory if you let it.
Takeout/
takeout_sidecars/
Output/
Library/
Albums/
phone-staging/
scratch/

# Local config: it holds real paths to a real drive.
gphotos.toml
config.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.tox/

# Editors / tooling
.idea/
.vscode/
.claude/
.DS_Store

# The one exception: the example config is checked in on purpose, and the test
# fixtures are hand-built files that contain nothing personal.
!gphotos.example.toml
!tests/fixtures/**
