# Deny by PATTERN, not by name. Every file this project produces about a real
# photo library is personal -- paths, GPS, people tags, captions, OAuth tokens --
# and a name-based list only blocks the files that existed when it was written.
# Anything new must be denied by default.

# Data: every manifest, ledger, plan and cache this tool writes.
*.tsv
*.tsv.gz
all_dates.txt
*_done.txt
*_report.txt
*.log

# Credentials. Never, under any name.
*token*.json
*client_secret*.json
*credentials*.json
.upload_test_passed

# Private notes. These stay in ~/.local/share/gphotos/notes/, never in git.
STATE.md
GOAL.md
PROCEDURE.md

# Working trees a run creates in the repo directory if you let it.
Takeout/
takeout_sidecars/
Output/
Library/
Albums/
phone-staging/
scratch/

# Local config: it holds real paths to a real drive.
gphotos.toml
config.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.tox/

# Editors / tooling
.idea/
.vscode/
.claude/
.DS_Store

# The example config is checked in on purpose.
!gphotos.example.toml

# The test fixtures are GENERATED, not committed -- tests/fixtures/build.py
# makes them and conftest.py runs it on demand. They contain nothing personal;
# they are excluded because binary blobs nobody can read in a diff are a bad
# way to describe what a test is testing.
tests/fixtures/mini_takeout/
